# ---- host 编译产物不上传（可运行 exe 在 dist/；源码 Program.cs + csproj 随库） ----
host/bin/
host/obj/
host/bar-debug.png

# ---- dist 只保留单文件 exe，忽略发布时散落的 config/dll 等 ----
dist/*
!dist/SoloChatHost.exe
# 外部扩展运行时由 ../extensions 同步到这里，不重复入库
plugins/
# 扩展包本地市场副本（node tools/sync-extensions.mjs 生成；dist/packages 已在 dist/* 忽略范围）
packages/
# 发布中间目录（dotnet publish -o dist-build），不属于源码
dist-build/

# ---- 本地配置与隐私（绝不上传） ----
# 内部开发日志：含本机路径、relay 端口、配置细节
SoloChat-开发记录.md
# 会话数据备份（含聊天记录）
idb-backup/
# 环境变量与本地密钥
.env
.env.*
*.local
# 其他本地备份与日志
*.bak
*.log

# ---- 工具会话数据（含对话/配置，勿入库） ----
.zcode/
.playwright-mcp/

# ---- 系统文件 ----
Thumbs.db
Desktop.ini
.DS_Store
